{
  "name": "dep-up-surgeon",
  "version": "4.3.0",
  "description": "Upgrade npm dependencies one-by-one with validation, rollback, and conflict reporting.",
  "main": "dist/cli.js",
  "bin": {
    "dep-up-surgeon": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "prepare": "npm run build",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test \"test/unit/*.test.mjs\" test/fixtures-runner.mjs",
    "test:unit": "npm run build && node --test \"test/unit/*.test.mjs\"",
    "test:fixtures": "npm run build && node --test test/fixtures-runner.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexlibe95/dep-up-surgeon.git"
  },
  "keywords": [
    "npm",
    "dependencies",
    "upgrade",
    "cli",
    "semver"
  ],
  "author": "Alexandros Lymperopoulos",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/alexlibe95/dep-up-surgeon/issues"
  },
  "homepage": "https://dep-up-surgeon.netlify.app/",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "execa": "^10.1.0",
    "fs-extra": "11.4.1",
    "pacote": "22.0.0",
    "prompts": "^2.4.2",
    "semver": "7.8.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "26.6.5",
    "@types/prompts": "^2.4.9",
    "@types/semver": "7.8.0",
    "typescript": "7.0.2"
  }
}
